{
  "name": "plybit-otc-signals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npx next build --no-turbo && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate"
  },
  "dependencies": {
